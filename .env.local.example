# Supabase (crear proyecto en https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Push (notificaciones del navegador a las 9:00 y 21:00)
# Generar claves VAPID: node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log('PUBLIC:',k.publicKey); console.log('PRIVATE:',k.privateKey);"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Cron (Vercel envía este header al llamar /api/cron/notify)
CRON_SECRET=
# Para que el cron lea usuarios y suscripciones (Project Settings → API)
SUPABASE_SERVICE_ROLE_KEY=
